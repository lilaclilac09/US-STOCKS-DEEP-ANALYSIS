# ==================== 数据源切换（核心！） ====================
VITE_ACTIVE_DATA_PROVIDER=mock          # 改成 polygon / finnhub / alphavantage / yahoo 即可切换

# ==================== 你之前存的所有 key（随便加） ====================
VITE_POLYGON_API_KEY=pk_xxxxxxxxxxxxxxxxxxxx
VITE_FINNHUB_API_KEY=cxxxxxxxxxxxxxxxxxxxxxx
VITE_ALPHAVANTAGE_API_KEY=xxxxxxxxxxxxxxxxxxxx
VITE_YAHOO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# Supabase（如果还在用）
VITE_SUPABASE_URL=https://你的.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 以后想加新数据中心，直接在这里加一行就行
# VITE_新数据中心_API_KEY=你的key
