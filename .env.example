# ============================================================
# FRONTEND env vars
#
# WARNING: any VITE_-prefixed variable is statically inlined
# into the public JavaScript bundle at build time. Anyone who
# loads the site can read its value. Never put a real secret
# behind a VITE_* name.
# ============================================================

# Finnhub — live price overlay. Read in src/App.tsx.
# (VITE_FINNHUB_KEY is also accepted as a legacy alias.)
VITE_FINNHUB_API_KEY=

# Supabase — watchlist + per-symbol cache. Read in src/clients/supabase.ts.
# The anon key is intended to be public; pair it with row-level
# security on every Supabase table this app reads or writes.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# PayloadCMS API base URL (optional). Read in src/clients/payload.ts.
# Defaults to http://localhost:3001/api when unset.
VITE_PAYLOAD_API_URL=

# ============================================================
# SERVERLESS function env vars (api/*)
#
# NOT inlined into the bundle. Safe to hold real secrets.
# In production, set these in the Vercel project settings,
# not in a committed file.
# ============================================================

# Resend — used by api/send-alert-email.ts to send price-alert emails.
RESEND_API_KEY=

# ============================================================
# PAYLOAD CMS backend (payload/)
# Only needed if you run the CMS locally.
# ============================================================

PAYLOAD_SECRET=
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
PORT=3002

# ============================================================
# MAINTENANCE scripts (scripts/*) — local CLI use only
# ============================================================

# scripts/migrate-to-payload.mjs
PAYLOAD_API_URL=http://localhost:3001/api
PAYLOAD_API_KEY=

# scripts/price-alerts.mjs
PRICE_ALERT_THRESHOLD_PCT=5
PRICE_ALERT_WEBHOOK=
